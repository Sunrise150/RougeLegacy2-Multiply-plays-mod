<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Zero-dependency test runner. No NuGet test framework is cached on this machine,
    so we implement a tiny [Fact] + Check harness (see TestRunner.cs). Run the
    project with dotnet run -c Release. Exit code 0 means all pass.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RL-Mod.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RL-Mod.Core/RL-Mod.Core.csproj" />
  </ItemGroup>
</Project>
